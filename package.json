{
  "name": "hms",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @hms/db migrate",
    "db:seed": "pnpm --filter @hms/db seed",
    "db:new": "pnpm --filter @hms/db new",
    "format": "prettier --write .",
    "db:reset": "pnpm --filter @hms/db reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "5.9.3"
  }
}
