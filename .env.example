# --- Database ---
# Migrations and seeds run as the owner role.
DATABASE_MIGRATOR_URL=postgres://hms_migrator:hms_migrator@localhost:5432/hms
# The API runs as the restricted role so row-level security is enforced.
DATABASE_URL=postgres://hms_app:hms_app@localhost:5432/hms

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
LOG_LEVEL=info

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
