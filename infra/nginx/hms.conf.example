# Host nginx in front of the HMS Docker stack (which listens on localhost:4001).
# 1. Copy:   sudo cp infra/nginx/hms.conf.example /etc/nginx/sites-available/hms.conf
# 2. Replace hms.example.com with your domain (its DNS A record must point at this server).
# 3. Enable: sudo ln -s /etc/nginx/sites-available/hms.conf /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# 4. HTTPS:  sudo certbot --nginx -d hms.example.com     (certbot adds the 443 block and the redirect)
# 5. In .env.prod set PUBLIC_URL=https://hms.example.com, then run ./deploy.sh again.

server {
  listen 80;
  listen [::]:80;
  server_name hms.example.com;

  client_max_body_size 20m;

  location / {
    proxy_pass http://127.0.0.1:4001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Tells the app the browser is on HTTPS, so login cookies are marked Secure.
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
  }
}
